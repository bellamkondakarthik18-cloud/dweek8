#include <stdio.h>
#include <math.h>

int main() {
    int choice, n, r, c, i, j;
    int O[20][20], row[20], col[20];
    int total, df;
    float E, chi, critical;

    do {
        printf("\n--- CHI-SQUARE TEST ---\n");
        printf("1. Calculate Chi-Square Value\n");
        printf("2. Goodness-of-Fit Test\n");
        printf("3. Test of Independence\n");
        printf("4. Calculate Degrees of Freedom\n");
        printf("5. Calculate Expected Frequency\n");
        printf("6. Decision Using Critical Value\n");
        printf("7. Display Hypotheses\n");
        printf("0. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            printf("Enter number of categories: ");
            scanf("%d", &n);

            if (n < 1 || n > 20) {
                printf("Invalid number of categories.\n");
                break;
            }

            chi = 0;
            for (i = 0; i < n; i++) {
                float obs, exp;

                printf("Enter observed and expected frequency: ");
                scanf("%f%f", &obs, &exp);

                if (exp <= 0) {
                    printf("Expected frequency must be positive.\n");
                    chi = -1;
                    break;
                }

                chi += pow(obs - exp, 2) / exp;
            }

            if (chi >= 0)
                printf("Chi-Square Value = %.2f\n", chi);
            break;

        case 2:
            printf("Enter number of categories (2-20): ");
            scanf("%d", &n);

            if (n < 2 || n > 20) {
                printf("Invalid number of categories.\n");
                break;
            }

            total = 0;
            chi = 0;

            printf("Enter observed frequencies:\n");
            for (i = 0; i < n; i++) {
                scanf("%d", &O[0][i]);

                if (O[0][i] < 0) {
                    total = -1;
                    break;
                }
                total += O[0][i];
            }

            if (total <= 0) {
                printf("Invalid total frequency.\n");
                break;
            }

            E = (float)total / n;

            for (i = 0; i < n; i++)
                chi += pow(O[0][i] - E, 2) / E;

            printf("Expected Frequency = %.2f\n", E);
            printf("Chi-Square Value = %.2f\n", chi);
            printf("Degrees of Freedom = %d\n", n - 1);
            break;

        case 3:
            printf("Enter rows and columns (2-20): ");
            scanf("%d%d", &r, &c);

            if (r < 2 || r > 20 || c < 2 || c > 20) {
                printf("Invalid table size.\n");
                break;
            }

            total = 0;
            chi = 0;

            for (i = 0; i < r; i++)
                row[i] = 0;
            for (j = 0; j < c; j++)
                col[j] = 0;

            printf("Enter observed frequency table:\n");

            for (i = 0; i < r; i++) {
                for (j = 0; j < c; j++) {
                    scanf("%d", &O[i][j]);

                    if (O[i][j] < 0) {
                        total = -1;
                        break;
                    }

                    row[i] += O[i][j];
                    col[j] += O[i][j];
                    total += O[i][j];
                }
                if (total == -1)
                    break;
            }

            if (total <= 0) {
                printf("Invalid frequency table.\n");
                break;
            }

            for (i = 0; i < r; i++) {
                for (j = 0; j < c; j++) {
                    E = (float)row[i] * col[j] / total;

                    if (E <= 0) {
                        chi = -1;
                        break;
                    }

                    chi += pow(O[i][j] - E, 2) / E;
                }
                if (chi < 0)
                    break;
            }

            if (chi < 0) {
                printf("Expected frequency is zero.\n");
                break;
            }

            df = (r - 1) * (c - 1);
            printf("Chi-Square Value = %.2f\n", chi);
            printf("Degrees of Freedom = %d\n", df);
            break;

        case 4:
            printf("1. Goodness-of-Fit\n");
            printf("2. Test of Independence\n");
            printf("Enter choice: ");
            scanf("%d", &n);

            if (n == 1) {
                printf("Enter number of categories: ");
                scanf("%d", &i);

                if (i < 2) {
                    printf("Invalid category count.\n");
                    break;
                }

                df = i - 1;
            } else if (n == 2) {
                printf("Enter rows and columns: ");
                scanf("%d%d", &r, &c);

                if (r < 2 || c < 2) {
                    printf("Invalid table size.\n");
                    break;
                }

                df = (r - 1) * (c - 1);
            } else {
                printf("Invalid choice.\n");
                break;
            }

            printf("Degrees of Freedom = %d\n", df);
            break;

        case 5:
            printf("Enter total frequency and categories: ");
            scanf("%d%d", &total, &n);

            if (total <= 0 || n < 1) {
                printf("Invalid input.\n");
                break;
            }

            E = (float)total / n;
            printf("Expected Frequency = %.2f\n", E);
            break;

        case 6:
            printf("Enter calculated Chi-Square value: ");
            scanf("%f", &chi);

            printf("Enter critical value from table: ");
            scanf("%f", &critical);

            if (chi < 0 || critical <= 0) {
                printf("Invalid values.\n");
                break;
            }

            if (chi > critical)
                printf("Reject H0\n");
            else
                printf("Fail to reject H0\n");
            break;

        case 7:
            printf("\nH0: No significant association exists.\n");
            printf("H1: A significant association exists.\n");
            break;

        case 0:
            printf("Program terminated.\n");
            break;

        default:
            printf("Invalid choice.\n");
        }

    } while (choice != 0);

    return 0;
}
